# ==============================================================================
# ChildTrack Environment Configuration (.env.example)
# Copy this file to .env and configure the values for your environment.
# NEVER commit real production secrets or .env to version control.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
DEBUG=true
APP_NAME=ChildTrack
APP_VERSION=0.1.0

# Server Binding
HOST=127.0.0.1
PORT=8000

# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./childtrack_dev.db
# For PostgreSQL (Production & Staging):
# DATABASE_URL=postgresql+asyncpg://childtrack_user:change_me_in_production@localhost:5432/childtrack_db

# Security & JWT Tokens
# Generate a secure 32+ byte random string: openssl rand -hex 32
SECRET_KEY=insecure-dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Structured JSON logs for production (true in prod, false in dev)
LOG_JSON_FORMAT=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Organization / School Settings (Defaults used only if DB singleton is unset)
DEFAULT_TIMEZONE=UTC

# Alert Settings (Defaults used only if DB singleton is unset)
DEFAULT_OFFLINE_THRESHOLD_MINUTES=5
DEFAULT_CRITICAL_OFFLINE_THRESHOLD_MINUTES=15
DEFAULT_LOW_BATTERY_PERCENT=20
DEFAULT_MIN_LOCALIZATION_CONFIDENCE=0.45

# Cloud MQTT Broker Configuration (HiveMQ Cloud)
MQTT_ENABLED=true
MQTT_BROKER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=inhousechildtracker
MQTT_PASSWORD=your_hivemq_password_here
MQTT_TOPIC_TELEMETRY=childtrack/telemetry
MQTT_TOPIC_ACK_PREFIX=childtrack/ack
MQTT_KEEPALIVE=60

# Proximity Testing Portal (Master-Slave Tether)
TESTING_PORTAL_ENABLED=true
TESTING_PORTAL_USERNAME=tester
TESTING_PORTAL_PASSWORD=Test@12345
MQTT_TOPIC_TESTING_TETHER=childtrack/testing/tether
